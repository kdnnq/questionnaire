{
  "name": "touble",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky && node scripts/ensure-husky.mjs",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,css,json}",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx,css,json}",
    "spell-check": "cspell \"src/**/*.{js,ts,jsx,tsx,vue}\"",
    "spell-check:all": "cspell \"**/*.{js,ts,md,txt}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "~6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/react": "^0.5.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "ahooks": "^3.9.7",
    "antd": "^6.6.1",
    "axios": "^1.19.0",
    "classnames": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "immer": "^11.1.17",
    "lodash": "^4.18.1",
    "lodash.clonedeep": "^4.5.0",
    "mockjs": "^1.1.0",
    "prettier": "^3.9.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "redux-undo": "^1.1.0",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cspell": "^8.19.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
